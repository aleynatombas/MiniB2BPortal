@model IReadOnlyList<OrderSummaryDto>
@{
    ViewData["Title"] = "Siparişlerim";
}

<div class="store-page">
<div class="container">
<h1 class="h3 mb-3">Siparişlerim</h1>

@if (TempData["Status"] is string status)
{
    <div class="alert alert-success">@status</div>
}

@if (Model.Count == 0)
{
    <div class="bg-white border p-4">
        <p class="mb-3">Henüz siparişiniz yok.</p>
        <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Ürünlere git</a>
    </div>
}
else
{
    <div class="table-responsive bg-white border">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Sipariş no</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th class="text-end">Tutar</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>@order.OrderDate.ToLocalTime().ToString("g")</td>
                    <td>@OrderDisplay.StatusText(order.Status)</td>
                    <td class="text-end">@order.TotalAmount.ToString("N2") ₺</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@order.Id">Detay</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
</div>
</div>
