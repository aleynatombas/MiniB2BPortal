@model HomeViewModel
@{
    ViewData["Title"] = "Ana sayfa";
}

<section class="hero">
    <img class="hero-car" src="~/uploads/sliders/hero-car.png" asp-append-version="true" alt="" />
    <div class="container">
        @if (Model.Sliders.Count > 0)
        {
            <div id="homeSlider" class="carousel slide" data-bs-ride="carousel">
                @if (Model.Sliders.Count > 1)
                {
                    <div class="carousel-indicators">
                        @for (var i = 0; i < Model.Sliders.Count; i++)
                        {
                            <button type="button" data-bs-target="#homeSlider" data-bs-slide-to="@i" class="@(i == 0 ? "active" : null)" aria-current="@(i == 0 ? "true" : null)" aria-label="Slayt @(i + 1)"></button>
                        }
                    </div>
                }
                <div class="carousel-inner">
                    @for (var i = 0; i < Model.Sliders.Count; i++)
                    {
                        var slide = Model.Sliders[i];
                        var hasImage = !string.IsNullOrWhiteSpace(slide.ImagePath);
                        <div class="carousel-item @(i == 0 ? "active" : null)">
                            <div class="hero-slide @(hasImage ? "has-media" : null)">
                                <div>
                                    <p class="hero-kicker">@slide.Title</p>
                                    <h1>@(string.IsNullOrWhiteSpace(slide.Subtitle) ? slide.Title : slide.Subtitle)</h1>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a class="btn btn-primary" href="@(string.IsNullOrWhiteSpace(slide.LinkUrl) ? "/Products" : slide.LinkUrl)">Kampanyaya git</a>
                                        <a class="btn btn-ghost" asp-controller="Products" asp-action="Index">Tüm parçalar</a>
                                    </div>
                                </div>
                                <div class="hero-visual">
                                    @if (hasImage)
                                    {
                                        <img src="@slide.ImagePath" alt="@slide.Title" />
                                    }
                                    else
                                    {
                                        <div class="hero-fallback">OT</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (Model.Sliders.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#homeSlider" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                        <span class="visually-hidden">Önceki</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#homeSlider" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                        <span class="visually-hidden">Sonraki</span>
                    </button>
                }
            </div>
        }
        else
        {
            <div class="hero-slide">
                <div>
                    <p class="hero-kicker">OtoTedarik B2B</p>
                    <h1>Servis stoğu. OEM kodlu parça.</h1>
                    <p>Fren, filtre, ateşleme ve aydınlatma parçalarını tek yerden sipariş edin.</p>
                    <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Alışverişe başla</a>
                </div>
                <div class="hero-visual"><div class="hero-fallback">OT</div></div>
            </div>
        }
    </div>
</section>

@if (TempData["Status"] is string status)
{
    <div class="container pt-4"><div class="alert alert-success">@status</div></div>
}
@if (TempData["Error"] is string error)
{
    <div class="container pt-4"><div class="alert alert-danger">@error</div></div>
}
@if (User.IsAdmin())
{
    <div class="container pt-4">
        <div class="alert alert-info mb-0">
            Yönetici vitrini görüntülüyor; sipariş verilemez.
            <a class="alert-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Yönetim paneline git</a>
        </div>
    </div>
}

@if (Model.Categories.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-title">
                <h2>Parçalarımız</h2>
            </div>
            <div class="part-grid">
                @{
                    var partPhotos = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                    {
                        ["Fren Sistemi"] = "/uploads/products/disc-caliper.jpg",
                        ["Filtreler"] = "/uploads/products/oil-filter.jpg",
                        ["Ateşleme"] = "/uploads/products/spark-plug.jpg",
                        ["Aydınlatma"] = "/uploads/products/h7-bulb.jpg"
                    };
                }
                @foreach (var category in Model.Categories.OrderBy(c => c.Name == "Fren Sistemi" ? 0 : 1))
                {
                    partPhotos.TryGetValue(category.Name, out var photo);
                    <a class="part-tile" asp-controller="Products" asp-action="Index" asp-route-term="@category.Name">
                        @if (!string.IsNullOrWhiteSpace(photo))
                        {
                            <img src="@photo" alt="@category.Name" />
                        }
                        <div class="part-meta">
                            <strong>@category.Name</strong>
                            <span>İncele</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    </section>
}

@if (Model.Featured.Count > 0)
{
    <section class="section section-muted">
        <div class="container">
            <div class="section-title">
                <span>ÖNE ÇIKANLAR</span>
                <h2>Servis stoğundan seçilenler</h2>
            </div>
            <div class="row g-4">
                @foreach (var product in Model.Featured)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
            <div class="text-center mt-4">
                <a class="btn btn-ghost" asp-controller="Products" asp-action="Index">Tüm ürünleri gör</a>
            </div>
        </div>
    </section>
}

<div class="container py-5">
    <div class="promo">
        <div>
            <h2>Servis stoğu kontrolü bizde</h2>
            <p class="mb-0">Sepete ekle, sipariş oluştur; yetersiz parçada işlem oluşmaz.</p>
        </div>
        <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Kataloga git</a>
    </div>
</div>

@{
    var partners = new (string Name, string File)[]
    {
        ("Bosch", "bosch.svg"),
        ("TRW", "trw.svg"),
        ("ATE", "ate.svg"),
        ("MANN", "mann.svg"),
        ("Mahle", "mahle.svg"),
        ("NGK", "ngk.svg"),
        ("Valeo", "valeo.svg"),
        ("Osram", "osram.svg"),
        ("Philips", "philips.svg"),
        ("Brembo", "brembo.svg"),
        ("Denso", "denso.svg"),
        ("Hella", "hella.svg")
    };
}
<section class="brand-marquee" aria-label="Çalıştığımız markalar">
    <p class="brand-marquee-kicker">Çalıştığımız markalar</p>
    <div class="brand-marquee-viewport">
        <div class="brand-marquee-track">
            @for (var copy = 0; copy < 2; copy++)
            {
                <div class="brand-marquee-group" aria-hidden="@(copy == 1 ? "true" : null)">
                    @foreach (var partner in partners)
                    {
                        <span class="brand-chip">
                            <img src="~/uploads/brands/@partner.File" asp-append-version="true" alt="@partner.Name" />
                        </span>
                    }
                </div>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-title">
            <span>NEDEN BİZ</span>
            <h2>Neden OtoTedarik?</h2>
        </div>
        <div class="why-grid">
            <article class="why-card">
                <span class="why-num">01</span>
                <h3>Doğru parça</h3>
                <p>OEM ve üretici koduyla arayın; servise uygun parçayı bulun.</p>
            </article>
            <article class="why-card">
                <span class="why-num">02</span>
                <h3>Güncel stok</h3>
                <p>Siparişte stok kontrol edilir; yetersiz parçada işlem oluşmaz.</p>
            </article>
            <article class="why-card">
                <span class="why-num">03</span>
                <h3>Hızlı sevkiyat</h3>
                <p>İstanbul içi siparişler 24 saat içinde hazırlanır.</p>
            </article>
            <article class="why-card">
                <span class="why-num">04</span>
                <h3>Bayi fiyatı</h3>
                <p>Servis ve bayilere özel B2B fiyatıyla sipariş verin.</p>
            </article>
        </div>
    </div>
</section>
