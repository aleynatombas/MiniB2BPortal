@model ProductGridCellModel
@{
    var column = Model.Column;
    var product = Model.Product;
    var inStock = product.StockQuantity > 0;
    var detailUrl = Url.Action("Details", "Products", new { area = "", id = product.Id, term = Model.Term });
    var popupUrl = Url.Action("Details", "Products", new { area = "", id = product.Id, term = Model.Term, partial = true });
}

@switch (column.RenderType)
{
    case GridRenderType.Image:
        <a href="@detailUrl" class="js-product-detail" data-detail-url="@popupUrl" data-product-name="@product.Name">
            @if (!string.IsNullOrWhiteSpace(product.ImagePath))
            {
                <img src="@product.ImagePath" alt="@product.Name" width="48" height="48" class="thumb" />
            }
            else
            {
                <span class="text-muted small">Görsel yok</span>
            }
        </a>
        break;

    case GridRenderType.StockBadge:
        {
            var level = StockRules.Evaluate(product.StockQuantity, product.CriticalStockLevel);
            var css = level == StockLevel.Available ? "stock-ok" : level == StockLevel.Critical ? "stock-low" : "stock-out";
            var text = level == StockLevel.Available ? "Var" : level == StockLevel.Critical ? "Kritik" : "Yok";
            <span class="stock-badge @css">@text</span>
        }
        break;

    case GridRenderType.Currency:
        {
            var raw = ProductFieldAccessor.GetValue(product, column.FieldName);
            var price = raw is decimal amount ? amount : product.Price;
            <span>@price.ToString("N2") ₺</span>
        }
        break;

    case GridRenderType.QuantityInput:
        if (User.IsAdmin())
        {
            <span class="text-muted">—</span>
        }
        else
        {
            <input type="number" name="quantity" class="form-control form-control-sm qty-input" value="1" min="1" max="@Math.Max(product.StockQuantity, 1)" form="cart-@product.Id" @(inStock ? null : "disabled") />
        }
        break;

    case GridRenderType.AddToCartButton:
        if (User.IsAdmin())
        {
            <span class="text-muted small">Yalnızca yönetim</span>
        }
        else
        {
            <form id="cart-@product.Id" asp-action="AddToCart" method="post">
                <input type="hidden" name="productId" value="@product.Id" />
                <input type="hidden" name="term" value="@Model.Term" />
                <button type="submit" class="btn btn-sm btn-primary" @(inStock ? null : "disabled")>Sepete ekle</button>
            </form>
        }
        break;

    default:
        <a href="@detailUrl" class="js-product-detail" data-detail-url="@popupUrl" data-product-name="@product.Name">@ProductFieldAccessor.GetText(product, column.FieldName)</a>
        break;
}
