@model LoginViewModel
@{
    ViewData["Title"] = "Giriş";
    ViewData["HideFooter"] = true;
    var isAdminPortal = string.Equals(Model.Portal, "admin", StringComparison.OrdinalIgnoreCase);
    var isCustomerPortal = string.Equals(Model.Portal, "customer", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Portal, "bayi", StringComparison.OrdinalIgnoreCase);
    var showChooser = !isAdminPortal && !isCustomerPortal;
}

<div class="auth-shell">
    <div class="auth-visual">
        <p class="hero-kicker">İki ayrı giriş</p>
        <h1>Kullanıcı alışveriş yapar.<br />Yönetici paneli yönetir.</h1>
        <p>Kullanıcı: katalog, sepet, sipariş. Yönetici: ürün, kullanıcı ve sipariş yönetimi.</p>
    </div>
    <div>
        <div class="auth-card">
            @if (showChooser)
            {
                <p class="auth-kicker">Oturum</p>
                <h1>Giriş türünü seçin</h1>
                <p class="auth-lead">Görevler ayrıdır. Kullanıcı vitrine, yönetici panele gider.</p>
                <div class="portal-pick">
                    <a asp-action="Login" asp-route-portal="customer" asp-route-returnUrl="@Model.ReturnUrl">
                        <strong>Kullanıcı girişi</strong>
                        <span>Katalog, sepet ve sipariş. Demo: bayi / Bayi123!</span>
                    </a>
                    <a asp-action="Login" asp-route-portal="admin" asp-route-returnUrl="@Model.ReturnUrl">
                        <strong>Yönetici girişi</strong>
                        <span>Ürün, kullanıcı ve sipariş yönetimi. Demo: admin / Admin123!</span>
                    </a>
                </div>
            }
            else
            {
                <p class="auth-kicker">@(isAdminPortal ? "Yönetim paneli" : "Kullanıcı vitrini")</p>
                <h1>@(isAdminPortal ? "Yönetici girişi" : "Kullanıcı girişi")</h1>
                <p class="auth-lead">
                    @(isAdminPortal
                        ? "Giriş sonrası ürün, kullanıcı ve sipariş yönetimine yönlendirilirsiniz."
                        : "Giriş sonrası katalog, sepet ve siparişlere yönlendirilirsiniz.")
                </p>
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Portal" />
                    <div class="mb-3">
                        <label asp-for="UsernameOrEmail" class="form-label"></label>
                        <input asp-for="UsernameOrEmail" class="form-control" autocomplete="username" />
                        <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
                </form>
                <p class="mt-3 mb-0 text-center">
                    @if (isAdminPortal)
                    {
                        <a asp-action="Login" asp-route-portal="customer">Kullanıcı girişi</a>
                    }
                    else
                    {
                        <span>Hesabınız yok mu? <a asp-action="Register">Bayi kaydı</a></span>
                        <span class="d-block mt-2"><a asp-action="Login" asp-route-portal="admin">Yönetici girişi</a></span>
                    }
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
