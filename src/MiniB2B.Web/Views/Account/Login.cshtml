@model LoginViewModel
@{
    ViewData["Title"] = "Giriş";
}

<div class="auth-shell">
    <div class="auth-visual">
        <p class="hero-kicker">Yedek parça</p>
        <h1>OEM kodlu stok.<br />Servise özel fiyat.</h1>
        <p>Katalog, sepet ve sipariş için hesabınızla giriş yapın. Demo: bayi / Bayi123! · admin / Admin123!</p>
    </div>
    <div>
        <div class="auth-card">
            <p class="auth-kicker">Hesap</p>
            <h1>Giriş yap</h1>
            <p class="auth-lead">Sipariş ve katalog için oturum açın.</p>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="UsernameOrEmail" class="form-label"></label>
                    <input asp-for="UsernameOrEmail" class="form-control" autocomplete="username" />
                    <span asp-validation-for="UsernameOrEmail" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
            </form>
            <p class="mt-3 mb-0 text-center">
                Hesabınız yok mu? <a asp-action="Register">Kayıt ol</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
