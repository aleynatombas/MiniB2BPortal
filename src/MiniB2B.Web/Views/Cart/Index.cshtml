@model CartDto
@{
    ViewData["Title"] = "Sepet";
}

<div class="store-page">
<div class="container">
<div class="page-head d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">Sepet</h1>
    <a class="btn btn-ghost" asp-controller="Products" asp-action="Index">Alışverişe devam</a>
</div>

@if (TempData["Status"] is string status)
{
    <div class="alert alert-success">@status</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (Model.Items.Count == 0)
{
    <div class="bg-white border p-4">
        <p class="mb-3">Sepetiniz boş.</p>
        <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Ürünlere git</a>
    </div>
}
else
{
    <div class="table-responsive bg-white border">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="d-none d-sm-table-cell"></th>
                    <th>Ürün</th>
                    <th class="text-end d-none d-md-table-cell">Birim fiyat</th>
                    <th class="text-center" style="width:140px">Adet</th>
                    <th class="text-end">Satır tutarı</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr class="@(item.ExceedsStock ? "table-warning" : null)">
                    <td class="d-none d-sm-table-cell" style="width:56px">
                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                        {
                            <img src="@item.ImagePath" alt="" width="40" height="40" class="thumb" />
                        }
                    </td>
                    <td>
                        <div class="small text-muted">@item.ProductCode</div>
                        <div>@item.Name</div>
                        @if (!item.IsActive)
                        {
                            <div class="small text-danger">Ürün artık satışta değil.</div>
                        }
                        else if (item.ExceedsStock)
                        {
                            <div class="small text-danger">Mevcut stok: @item.StockQuantity</div>
                        }
                    </td>
                    <td class="text-end d-none d-md-table-cell">@item.UnitPrice.ToString("N2") ₺</td>
                    <td>
                        <form asp-action="Update" method="post" class="d-flex gap-1 justify-content-center flex-wrap">
                            <input type="hidden" name="itemId" value="@item.ItemId" />
                            <input type="number" name="quantity" class="form-control form-control-sm qty-input" value="@item.Quantity" min="1" max="@Math.Max(item.StockQuantity, 1)" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Güncelle</button>
                        </form>
                    </td>
                    <td class="text-end">@item.LineTotal.ToString("N2") ₺</td>
                    <td class="text-end">
                        <form asp-action="Remove" method="post" class="m-0">
                            <input type="hidden" name="itemId" value="@item.ItemId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="6" class="text-end">Toplam @Model.Total.ToString("N2") ₺</th>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (Model.Items.Any(i => i.ExceedsStock))
    {
        <p class="text-danger mt-3 mb-0">Stok yetersiz ürünler var. Sipariş oluşturmadan önce adetleri düzeltin.</p>
    }
    else
    {
        <form asp-controller="Orders" asp-action="Create" method="post" class="mt-3">
            <button type="submit" class="btn btn-primary">Sipariş Oluştur</button>
        </form>
    }
}
</div>
</div>
