@model IReadOnlyList<ProductGridColumnDto>
@{
    ViewData["Title"] = "Grid kolonları";
}

<h1 class="h3 mb-3">Grid kolonları</h1>
<p class="text-muted">Bayi ürün tablosunun kolonları veritabanından gelir. Kod değiştirmeden buradan ayarlanır.</p>

<div class="table-responsive bg-white border">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Sıra</th>
                <th>Başlık</th>
                <th>Alan</th>
                <th>Tip</th>
                <th>Görünür</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SortOrder</td>
                <td>@item.Header</td>
                <td>@item.FieldName</td>
                <td>@item.RenderType</td>
                <td>@(item.IsVisible ? "Evet" : "Hayır")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
