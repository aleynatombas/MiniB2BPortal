@model IReadOnlyList<OrderSummaryDto>
@{
    ViewData["Title"] = "Siparişler";
}

<h1 class="h3 mb-3">Siparişler</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">Henüz sipariş yok.</p>
}
else
{
    <div class="table-responsive bg-white border">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Sipariş no</th>
                    <th>Kullanıcı</th>
                    <th>Tarih</th>
                    <th class="text-end">Tutar</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>@order.CustomerName</td>
                    <td>@order.OrderDate.ToLocalTime().ToString("g")</td>
                    <td class="text-end">@order.TotalAmount.ToString("N2") ₺</td>
                    <td>@OrderDisplay.StatusText(order.Status)</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@order.Id">Detay</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
