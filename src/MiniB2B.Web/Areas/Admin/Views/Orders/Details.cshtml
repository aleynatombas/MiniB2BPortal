@model OrderDetailDto
@{
    ViewData["Title"] = $"Sipariş {Model.OrderNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sipariş @Model.OrderNumber</h1>
    <a class="btn btn-outline-secondary" asp-action="Index">Listeye dön</a>
</div>

<div class="bg-white border p-3 mb-3">
    <div><strong>Kullanıcı:</strong> @Model.CustomerName</div>
    <div><strong>Tarih:</strong> @Model.OrderDate.ToLocalTime().ToString("g")</div>
    <div><strong>Durum:</strong> @OrderDisplay.StatusText(Model.Status)</div>
</div>

<div class="table-responsive bg-white border mb-3">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Kod</th>
                <th>Ürün</th>
                <th class="text-center">Adet</th>
                <th class="text-end">Birim fiyat</th>
                <th class="text-end">Satır tutarı</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductCode</td>
                <td>@item.ProductName</td>
                <td class="text-center">@item.Quantity</td>
                <td class="text-end">@item.UnitPrice.ToString("N2") ₺</td>
                <td class="text-end">@item.LineTotal.ToString("N2") ₺</td>
            </tr>
        }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="4" class="text-end">Toplam</th>
                <th class="text-end">@Model.TotalAmount.ToString("N2") ₺</th>
            </tr>
        </tfoot>
    </table>
</div>

@if (Model.Status == OrderStatus.Pending)
{
    <div class="d-flex gap-2">
        <form asp-action="SetStatus" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="status" value="@OrderStatus.Approved" />
            <button type="submit" class="btn btn-primary">Onayla</button>
        </form>
        <form asp-action="SetStatus" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="status" value="@OrderStatus.Rejected" />
            <button type="submit" class="btn btn-outline-danger">Reddet</button>
        </form>
    </div>
}
