@model IReadOnlyList<SliderDto>
@{
    ViewData["Title"] = "Slider";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Slider</h1>
    <a class="btn btn-primary" asp-action="Create">Yeni slider</a>
</div>

<div class="table-responsive bg-white border">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th></th>
                <th>Başlık</th>
                <th>Sıra</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td style="width:88px">
                    @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                    {
                        <img src="@item.ImagePath" alt="" width="72" height="32" class="thumb" />
                    }
                </td>
                <td>
                    <div>@item.Title</div>
                    <div class="small text-muted">@item.Subtitle</div>
                </td>
                <td>@item.DisplayOrder</td>
                <td>@(item.IsActive ? "Aktif" : "Pasif")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id">Düzenle</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
